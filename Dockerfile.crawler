# Morrowlane crawler service — Crawl4AI behind POST /fetch, for JavaScript-rendered
# sites the plain HTTP fetcher can't read. This runs a full headless browser, which is
# why it lives in a container on Railway and can never fit a serverless function.
# Railway: create a service from this repo and set RAILWAY_DOCKERFILE_PATH=Dockerfile.crawler
FROM python:3.12-slim
WORKDIR /app

COPY services/crawler/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
  # Installs the Playwright Chromium build and its system libraries for Crawl4AI.
  && playwright install --with-deps chromium \
  && rm -rf /var/lib/apt/lists/*

COPY services/crawler/ ./

# Railway injects PORT. Point the worker's CRAWLER_SERVICE_URL at this service's
# private domain and the crawl engine escalates to it automatically.
ENV PYTHONUNBUFFERED=1
# Bind :: — Railway private networking is IPv6-only, and the worker reaches this
# service over it as http://crawler.railway.internal:8020.
CMD ["sh", "-c", "uvicorn app:app --host :: --port ${PORT:-8020}"]
