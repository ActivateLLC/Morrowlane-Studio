{
  "name": "@morrowlane/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@morrowlane/shared": "workspace:*",
    "@morrowlane/brand-engine": "workspace:*",
    "@morrowlane/campaign-engine": "workspace:*",
    "@morrowlane/content-engine": "workspace:*",
    "@morrowlane/crawl-engine": "workspace:*",
    "@morrowlane/database": "workspace:*",
    "@morrowlane/social": "workspace:*",
    "@morrowlane/analytics": "workspace:*",
    "@morrowlane/creative-engine": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}