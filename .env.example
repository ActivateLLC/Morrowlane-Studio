# ------------------------------------------------------------------ database / auth
# Leave unset to run on the in-memory store with the local demo session.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required once real social connections are stored (encrypts access tokens at rest).
MORROWLANE_ENCRYPTION_KEY=

# ------------------------------------------------------------------ AI
# Leave both unset to use the deterministic local composer (demo quality).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Prefer one provider when both are configured: anthropic | openai
AI_PROVIDER=

# ------------------------------------------------------------------ social networks
# Per network. Unconfigured networks are hidden from the Connect screen.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
# Force mock providers everywhere (demo/publishing-pipeline development):
MORROWLANE_MOCK_SOCIAL=

# ------------------------------------------------------------------ services
CRAWLER_SERVICE_URL=
CREATIVE_SERVICE_URL=
VIDEO_SERVICE_URL=
# Attribution ingestion API bearer key (apps/api).
MORROWLANE_INGEST_KEY=

# ------------------------------------------------------------------ runtime
# Set to "external" when a separate worker process runs the queue.
MORROWLANE_WORKER=
LOG_LEVEL=
