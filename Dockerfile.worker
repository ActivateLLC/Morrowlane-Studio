# Morrowlane worker — the job queue and scheduled publishing.
# Railway: create a service from this repo and set RAILWAY_DOCKERFILE_PATH=Dockerfile.worker
FROM node:22-alpine
WORKDIR /app
RUN corepack enable

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps/worker ./apps/worker
RUN pnpm install --frozen-lockfile --ignore-scripts

# Required env at runtime: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# MORROWLANE_ENCRYPTION_KEY, and an AI key (ANTHROPIC_API_KEY or OPENAI_API_KEY).
CMD ["pnpm", "--filter", "@morrowlane/worker", "start"]
